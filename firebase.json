{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/src/importMap.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/importmap+json"
          }
        ]
      }
    ]
  },
  "emulators": {
    "host": "0.0.0.0",
    "hosting": {
      "port": 5000
    }
  }
}